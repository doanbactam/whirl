# Deployment used by `bunx convex dev` (written automatically on first run).
CONVEX_DEPLOYMENT=dev:your-deployment

# Everything below is set on the Convex deployment itself, not in this file:
#   bunx convex env set NAME value
# Listed here so you know what the backend reads. docs/configuration.md has
# the full reference.

# ---- Required ---------------------------------------------------------------

# Your Clerk instance's Frontend API URL. Clerk needs a JWT template named
# "convex" (see docs/self-hosting.md).
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# Every model call (chat, titles, images, transcription) goes through OpenRouter.
# OPENROUTER_API_KEY=sk-or-v1-...

# The web app's public origin. Share links, OAuth returns, checkout redirects
# and emails are built against it. Defaults to http://localhost:3000.
# SITE_URL=https://your-domain

# ---- Optional: each feature switches on with its keys -----------------------

# Integrations (MCP servers): encrypts stored credentials. 32 random bytes,
# base64. Generate one with: openssl rand -base64 32
# MCP_ENCRYPTION_KEY=...

# Web search and page fetching (exa.ai). Without it the search toggle hides.
# EXA_API_KEY=...

# Long-term memory (supermemory.ai). Without it memory stays off.
# SUPERMEMORY_API_KEY=...

# Billing (useautumn.com, with Stripe behind it). Without it every user gets
# every feature and nothing is metered. See docs/configuration.md for the
# products and features Whirl expects.
# AUTUMN_SECRET_KEY=am_sk_test_...

# Composio-backed integrations in the store.
# COMPOSIO_API_KEY=...

# PostHog server-side LLM analytics ($ai_generation events). Use the same
# project token as the client.
# POSTHOG_PROJECT_TOKEN=phc_your_project_token
# POSTHOG_HOST=https://us.i.posthog.com
# Set to "true" to redact prompt/response content from LLM analytics events.
# POSTHOG_LLM_PRIVACY_MODE=false
# The free-tier overload throttle: a personal API key (read access) plus the
# /run URL of a saved PostHog endpoint that returns today's free-tier spend in
# USD. Leave either unset and the throttle never engages.
# POSTHOG_PERSONAL_API_KEY=phx_...
# POSTHOG_FREE_COST_ENDPOINT=https://us.posthog.com/api/projects/<id>/endpoints/<name>/run

# Braintrust tracing for chat turns, tool spans and background LLM helpers.
# Pin a project by id, or name one (it's created if missing; default "Whirl").
# BRAINTRUST_API_KEY=sk-...
# BRAINTRUST_PROJECT_ID=...
# BRAINTRUST_PROJECT_NAME=Whirl

# Axiom operational telemetry. Keep the token server-only.
# AXIOM_TOKEN=xaat_your_ingest_token
# AXIOM_DATASET=web
# AXIOM_HOST=https://api.axiom.co

# Email through Resend. The Clerk webhook (mounted at /api/clerk-webhook)
# syncs sign-ups to an audience; transactional mail (the Platinum invite)
# sends from a verified domain.
# CLERK_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=re_...
# RESEND_AUDIENCE_ID=...
# RESEND_FROM_EMAIL=Whirl <hello@your-domain>

# Vercel deploy webhook (mounted at /api/deploy-hook): tells open tabs a new
# version shipped.
# VERCEL_WEBHOOK_SECRET=...

# The Median support agent (median.sh). Shared with the web app, where the
# agent's tool route runs (apps/v2/median.config.ts).
# MEDIAN_KEY=median_key_...
# MEDIAN_SUPPORT_SECRET=...

# Kirkify (/kirkify). Shared with the web app. Also salts visitor IP hashes.
# KIRKIFY_SECRET=...
