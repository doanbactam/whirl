# ---- Required ---------------------------------------------------------------

# Your Convex deployment (printed by `bunx convex dev` in packages/backend).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Clerk (dashboard → API keys).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# The app's public origin, for canonical URLs, the sitemap and share cards.
# On Vercel the production domain fills in for it; anywhere else, set it.
# NEXT_PUBLIC_SITE_URL=https://your-domain

# ---- Optional ---------------------------------------------------------------

# PostHog product analytics. The project token is a public browser ingest key.
# Leave unset to disable analytics.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Axiom web vitals and logs. Keep the token server-only: browser vitals are
# proxied through /api/axiom so it is never bundled into the client.
# AXIOM_TOKEN=xaat_your_ingest_token
# AXIOM_DATASET=web

# The Median support agent. Without MEDIAN_KEY the Support menu item hides.
# Server-only: the widget gets the median_pk_ half, derived from this at
# runtime, and MEDIAN_KEY itself signs identities and tool calls. Never put it
# behind NEXT_PUBLIC_. MEDIAN_SUPPORT_SECRET must match the Convex deployment.
# MEDIAN_KEY=median_key_...
# MEDIAN_SUPPORT_SECRET=...

# Kirkify (/kirkify). Without it the page 404s. Must match KIRKIFY_SECRET in
# the Convex deployment; it also salts IP hashes, so rotating it resets that
# day's anonymous counters.
# KIRKIFY_SECRET=...

# The version string the "update available" prompt compares. Vercel provides
# its own; set this on other hosts.
# GIT_COMMIT_SHA=...

# Extra hosts allowed to reach the dev server (a proxy, another device),
# comma-separated.
# DEV_ALLOWED_ORIGINS=my-laptop.local,192.168.1.20
