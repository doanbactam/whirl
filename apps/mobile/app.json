{
  "expo": {
    "name": "Whirl",
    "slug": "whirl",
    "version": "1.0.0",
    "scheme": "whirl",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f3f3f4",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saltjsx.whirl",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.saltjsx.whirl"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72be3d46-d99b-4fc1-bf41-4a711ce2cd14"
      }
    },
    "owner": "saltjsx",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/72be3d46-d99b-4fc1-bf41-4a711ce2cd14"
    }
  }
}
