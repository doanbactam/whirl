# The same Convex deployment and Clerk instance as the web app (apps/v2).
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# The web app this console administers, for the "Open Whirl" link.
# Defaults to http://localhost:3000.
# VITE_APP_URL=https://your-domain

# PostHog (client analytics). Public, write-only ingest key — safe to ship to
# the browser. Leave unset to disable analytics.
# VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Extra hosts allowed to reach the dev server, comma-separated.
# DEV_ALLOWED_ORIGINS=my-laptop.local
