VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# PostHog (client analytics). The project token is a public, write-only ingest
# key, so it's safe to ship to the browser. Leave unset to disable analytics.
VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# The Convex deployment itself is configured in packages/backend — see
# packages/backend/.env.example for the server-side env vars it needs.
